# ─── Plex ───────────────────────────────────
PLEX_SERVER_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# ─── qBittorrent ────────────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin
QBIT_SAVE_PATH=/downloads

# ─── IPTV ───────────────────────────────────
# Option A: M3U URL
IPTV_M3U_URL=

# Option B: Xtream Codes
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# ─── TMDB (optional — enriches seedbox library with posters/ratings) ──
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Seedbox (optional — enables SSH-based streaming) ──
SEEDBOX_HOST=
SEEDBOX_PORT=22
SEEDBOX_USER=
SEEDBOX_MEDIA_PATH=
SEEDBOX_KEY_PATH=

# ─── Server ─────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change_me_in_production
