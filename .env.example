# ─── Plex ───────────────────────────────────
PLEX_SERVER_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# ─── qBittorrent ────────────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin
QBIT_SAVE_PATH=/downloads

# ─── IPTV ───────────────────────────────────
# Option A: M3U URL
IPTV_M3U_URL=

# Option B: Xtream Codes
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# ─── Server ─────────────────────────────────
PORT=3001
NODE_ENV=development
