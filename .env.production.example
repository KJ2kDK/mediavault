# ─── MediaVault production .env (VPS) ───────────────────────────────────
# Copy to .env on the VPS (inside the mediavault repo dir). Never commit .env.
#
# Generate JWT_SECRET on VPS with:  openssl rand -hex 32

NODE_ENV=production
PORT=3001
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── TMDB (rotate the dev key before using here) ─────────────────────────
TMDB_API_KEY=CHANGE_ME

# ─── Plex ────────────────────────────────────────────────────────────────
PLEX_SERVER_URL=
PLEX_TOKEN=

# ─── qBittorrent ─────────────────────────────────────────────────────────
QBIT_URL=
QBIT_USERNAME=
QBIT_PASSWORD=
QBIT_SAVE_PATH=/downloads

# ─── IPTV / Xtream ───────────────────────────────────────────────────────
IPTV_M3U_URL=
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# ─── Seedbox (SSH) ───────────────────────────────────────────────────────
# The key path below is the path INSIDE the container — it's mounted from
# the VPS host at /root/.ssh/id_ed25519 by docker-compose.yml.
SEEDBOX_HOST=hati.whatbox.ca
SEEDBOX_PORT=22
SEEDBOX_USER=spliffstar
SEEDBOX_MEDIA_PATH=/home/spliffstar/Downloads
SEEDBOX_KEY_PATH=/root/.ssh/id_ed25519
